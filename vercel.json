{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "_buildCommandNote": "This ONLY runs because the frontend was moved out of the `builds` array and is served as ordinary static output below. While a `builds` array exists, Vercel IGNORES buildCommand entirely, so `npm run build` never ran and `public/build` (gitignored, so never uploaded) stayed at whatever stale copy sat in the working directory. Measured 2026-10-07: a deploy shipped a JS bundle from 06/10 containing fabricated prices because of exactly this.",
  "builds": [
    { "src": "/api/index.php", "use": "vercel-php@0.9.0", "config": { "excludeFiles": "{public/img/**,node_modules/**,.opencode/**,.git/**,.vercel/**,tests/**,test-results/**,storage/logs/**,database/scraped/**,.phpunit.result.cache}" } },
    { "src": "/public/css/**", "use": "@vercel/static" },
    { "src": "/public/js/**", "use": "@vercel/static" },
    { "src": "/public/fonts/**", "use": "@vercel/static" },
    { "src": "/public/img/**", "use": "@vercel/static" },
    { "src": "/public/textures/**", "use": "@vercel/static" },
    { "src": "/public/generated/**", "use": "@vercel/static" },
    { "src": "/public/favicon*", "use": "@vercel/static" },
    { "src": "/public/robots.txt", "use": "@vercel/static" },
    { "src": "/public/llms.txt", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/build/assets/(.*)", "dest": "/public/build/assets/$1" },
    { "src": "/build/manifest.json", "dest": "/public/build/manifest.json" },
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/js/(.*)", "dest": "/public/js/$1" },
    { "src": "/fonts/(.*)", "dest": "/public/fonts/$1" },
    { "src": "/generated/(.*)", "dest": "/public/generated/$1" },
    { "src": "/img/(.*)", "dest": "/public/img/$1" },
    { "src": "/textures/(.*)", "dest": "/public/textures/$1" },
    { "src": "/favicon(.*)", "dest": "/public/favicon$1" },
    { "src": "/robots.txt", "dest": "/public/robots.txt" },
    { "src": "/llms.txt", "dest": "/public/llms.txt" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE": "array",
    "QUEUE_CONNECTION": "sync"
  }
}
