APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL (used on Vercel)
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# Deployment (Vercel serverless). Set both to '1' so a fresh deploy migrates the
# schema and imports the PCPartPicker catalogue once at runtime.
# MIGRATE_ON_DEPLOY=1
# SEED_CATALOG_ONCE=1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Checkout pricing — Build & Delivery fee, PayPal processing fee and currency.
# BUILD_DELIVERY_FEE=250
# PAYPAL_FEE_RATE=0.03
# PAYPAL_CURRENCY=GBP

# PayPal (orders). Leave empty to keep checkout in "not configured" mode.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Metenzi (software store fulfilment). Leave METENZI_API_KEY empty to keep
# the store in "not configured" mode.
METENZI_BASE_URL=https://metenzi.com/api/public
METENZI_API_KEY=
# Only required when HMAC signing is enabled on the Metenzi account:
METENZI_SIGNING_SECRET=
# Returned when you register a webhook in the Metenzi seller portal
# (target URL: https://your-app/webhooks/metenzi). Optional while testing.
METENZI_WEBHOOK_SECRET=
# EUR → GBP conversion used to price software products (Metenzi invoices EUR).
METENZI_GBP_RATE=0.85

# Gemini (optional AI build enrichment). Leave GEMINI_API_KEY empty to use the
# plain heuristic recommender (no external calls).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=15

# Apify (PC component scraping). Get your token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# BuyWhere (Product catalog & price comparison). Get API key at https://api.buywhere.ai/
BUYWHERE_API_KEY=

# PriceAPI (Real-time e-commerce pricing). Get token at https://www.priceapi.com/
PRICEAPI_TOKEN=

# --- Awin product data feeds: real merchant price/stock EVIDENCE ------------
# Owner-held credential. The FEED api key is SEPARATE from the Publisher API
# key. Leave empty to disable feed downloads; the app then reports "not
# configured" rather than inventing prices.
#   feed list : https://productdata.awin.com/datafeed/list/apikey/{AWIN_FEED_API_KEY}
#   download  : https://productdata.awin.com/datafeed/download/apikey/{AWIN_FEED_API_KEY}/columns/.../format/csv/...
#   enhanced  : https://api.awin.com/publishers/{AWIN_PUBLISHER_ID}/awinfeeds/download/{advertiserId}-retail-en_GB.jsonl
# Supplied by the owner 2026-09-29: the Awin publisher/user ID for the
# pctechguyonline account. This identifies the ACCOUNT only - it is not a
# credential and it cannot be used in place of either key below.
#
# Probed on 2026-09-29: passing it as a feed key returns HTTP 403
# "Your access is disabled", and the list endpoint with no key returns
# HTTP 403 "No API key supplied". So the ID alone cannot reach any feed.
AWIN_PUBLISHER_ID=2850823
# ^ Note: this is the publisher USER ID, not a secret. Do not confuse it with
#   either key below. It identifies the account and nothing more.

# The FEED api key - from Awin > Product Data > Access Key (a separate secret
# from the Publisher API token). Needed for the CSV list/download lane.
AWIN_FEED_API_KEY=

# The Publisher API token - Bearer credential for the enhanced JSONL lane.
AWIN_API_TOKEN=
AWIN_FEED_LOCALE=en_GB

# --- ScraperAPI: cloud headless-browser lane for PCPartPicker ----------------
# Owner-supplied key (2026-09-29). Adds ScraperAPI render mode as the primary
# PCPartPicker fetcher; each call renders the page in a cloud browser (whose
# egress is NOT the local VPN) and solves the Cloudflare challenge server-side.
# Leave empty to use the local Byparr browser instead.
SCRAPER_API_KEY=

# --- WebScraper.io cloud: alternative scraping lane (sitemaps configured) ----
# Owner-supplied token (2026-09-29). The account already holds sitemaps for
# PCPP UK (1507853), Amazon UK (1507857) and Scan UK (1507858), but the account
# currently reports "Account not active" so no scraping job can start until the
# plan is reactivated. Leave empty to ignore.
WEBCRAPER_API_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# --- Builder 3D viewport -----------------------------------------------------
# Interactive three.js viewport of the configured build. DEFAULT OFF.
#
# Measured 2026-10-06 with scripts/verify-3d-render.mjs: the geometry is
# dimensionally correct (230 x 432 x 460 mm, 372 meshes, no page errors) and it
# passes all ten of its own automated checks, but the rendered frame is not
# recognisable as a PC. Verified live on pctechguy.app/builder, so it was
# reachable by customers. The approved Storefront Render is unaffected.
#
# Set to 1 only once the asset-driven rebuild (authored low-poly .glb parts with
# an interaction mesh for raycasting and a named RGB_Zone sub-mesh) is in place.
# Reads through config('builder.enable_3d_viewport') - do NOT call env() in the
# view, because config caching makes env() return null outside config files.
PCTG_ENABLE_3D_VIEWPORT=0
